TZ=Europe/Kyiv

CREATOR_ID=123456789
BOT_TOKEN=123456789:qwertyuiop
BOT_USERNAME=twitchviewer_bot

TWITCH_CLIENT_ID=qwertyuiop
TWITCH_CLIENT_SECRET=qwertyuiop

POSTGRESQL_HOST=postgres
POSTGRESQL_PORT=5432
DATABASE_NAME=twitchbot_db
DATABASE_USER=twitchbot
# generate a strong one, e.g.: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
DATABASE_PASSWORD=change-me

# optional: max clips recorded at the same time across ALL users (1..64, default 6);
# extra requests wait in a queue. Each clip = streamlink + ffmpeg + up to ~100 MB in /tmp
#MAX_CONCURRENT_CLIPS=6

# optional: container limits (see compose.yaml)
#BOT_MEM_LIMIT=2g
#BOT_TMP_SIZE=1g
#BOT_CPUS=2

# optional: set to 0 to disable the ffmpeg keyframe fix for Telegram previews
#CLIP_PREVIEW_FIX=1
